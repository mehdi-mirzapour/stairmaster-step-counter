# Environment & Virtual Environments
.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# Local Data, Raw Videos, and Presentations (Privacy & Lightweight Repo)
local/
local/**

# Raw heavy media formats (must be placed in local/)
*.avi
*.mov
*.wav
*.mp3
*.flac

# Restrict large video files - keep only lightweight 5s annotated sample
*.mp4
!output/solution2/sample2_5s_annotated.mp4
!docs/assets/sample2_5s_annotated.mp4

# Static image previews (prevent identity leakage)
*.jpg
*.jpeg

# Large model weights (Ultralytics auto-downloads yolov8n-pose.pt if missing)
*.pt

# Intermediate caches & frame inspection dumps
output/white_presentation/
output/inspect_s2/
output/**/temp_*.mp4
temp_*.mp4
.DS_Store
Thumbs.db
